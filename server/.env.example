# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asset_manager

# Any long random string. Everyone on the team can use a different one locally.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=24h

# AI features (Misbah and Hooria). Leave empty to use the rule-based fallback.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Seed admin account created by `npm run db:setup`
SEED_ADMIN_EMAIL=admin@cowork.local
SEED_ADMIN_PASSWORD=Admin@123
